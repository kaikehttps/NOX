{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'lastChanged']) && newData.child('state').isString() && newData.child('state').val().matches(/^(online|idle|dnd|offline)$/) && newData.child('lastChanged').val() === now",
        "state": { ".validate": true },
        "lastChanged": { ".validate": true },
        "$other": { ".validate": false }
      }
    }
  }
}
