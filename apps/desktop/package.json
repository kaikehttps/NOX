{
  "name": "@nox/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NOX — Seu grupo. Sua frequência.",
  "author": "NOX",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir --publish never",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "e2e": "node e2e/flow.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@nox/design-system": "*",
    "@nox/firebase": "*",
    "@nox/realtime": "*",
    "@nox/shared": "*",
    "@nox/validation": "*",
    "firebase": "^13.1.0",
    "livekit-client": "^2.23.0",
    "lucide-react": "^1.61.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.5",
    "playwright-core": "^1.64.1"
  }
}
