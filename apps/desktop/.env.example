# Copie para apps/desktop/.env (nunca versione o .env).
# Configuração PÚBLICA do app web do Firebase (Console → Configurações do projeto → Seus apps).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=nox-dev-xxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nox-dev-xxxxx
VITE_FIREBASE_STORAGE_BUCKET=nox-dev-xxxxx.firebasestorage.app
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_URL=https://nox-dev-xxxxx-default-rtdb.firebaseio.com

# URL do backend (Cloud Run). Local: http://127.0.0.1:8787
VITE_API_BASE_URL=http://127.0.0.1:8787

# true = usa o Firebase Emulator Suite em 127.0.0.1 (npm run emulators)
VITE_USE_EMULATORS=true

# Login Google no desktop: cliente OAuth do tipo "App para computador" (Google Cloud → Credenciais).
# Para clientes desktop o Google documenta que o secret não é confidencial (PKCE + loopback).
MAIN_VITE_GOOGLE_DESKTOP_CLIENT_ID=
MAIN_VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
