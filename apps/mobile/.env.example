# NOX mobile — copie para .env e preencha. Valores EXPO_PUBLIC_* são embutidos no app
# (configuração pública do Firebase, não são segredos). Nunca coloque chaves privadas aqui.

# Firebase (Console > Configurações do projeto > Seus apps > Web)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# API do NOX (Cloud Run). Em desenvolvimento: http://10.0.2.2:8787 no emulador Android.
EXPO_PUBLIC_API_BASE_URL=

# Emuladores do Firebase (true/false). 10.0.2.2 alcança o computador a partir do emulador Android;
# use o IP da sua máquina na rede para um aparelho físico, ou 127.0.0.1 no simulador iOS.
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2

# Login com Google (@react-native-google-signin/google-signin)
# Web client ID do OAuth (tipo "Aplicativo da Web") — é ele que gera o idToken aceito pelo Firebase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID e o URL scheme invertido (com.googleusercontent.apps.XXXX). Sem o scheme, o plugin é omitido.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Identificadores nativos (opcional; padrão app.nox.mobile)
# NOX_IOS_BUNDLE_ID=app.nox.mobile
# NOX_ANDROID_PACKAGE=app.nox.mobile
